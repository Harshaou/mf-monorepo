# Cloudflare Pages applies these response headers to the Shell's static output.
# Unlike the remotes, the Shell is the HOST — it is never loaded cross-origin, so it
# needs NO Access-Control-Allow-Origin. Only caching matters here.

# The HTML shell: always revalidate so a new deploy goes live on the next load instead
# of being pinned by a stale cached document.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Hashed, content-addressed assets (rsbuild emits to /static/): immutable, cache forever.
/static/*
  Cache-Control: public, max-age=31536000, immutable
